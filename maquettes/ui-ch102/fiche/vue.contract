// CH-102, proposition 1 « La fiche » : une page de réglages du système. L'état est le titre de la première carte, l'avancement
// sa barre ; les actions suivent, puis les chiffres et les cuts à poser, en lignes. Rien n'est peint : contrôles, couleurs et caractères du système.
use RowText, Badge from "exact:content"
// ---
routes nav
  home "/"
    plus "/plus"

component App
  state etat = "pret" persist
  state premier = "4790"
  state dernier = ""
  action agir
    etat = suite(etat)
  action arreter
    etat = "fin"
  action nouveau
    etat = "pret"
  action choisir(v: string)
    etat = v
  action ecrirePremier(v: string)
    premier = v
  action ecrireDernier(v: string)
    dernier = v
  action ouvrirPlus
    nav = push(nav, "/plus")
  action retour
    nav = back(nav)
  action suivre(url: string)
    nav = go(nav, url)
  view
    main testId="racine" navigationKey=`${top(nav).id}` navigationBack="retour" navigate=suivre width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="lot" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              text "Ariane" role="heading" aria-level=1 flex=1
              button press=ouvrirPlus aria-label="Plus" testId="plus"
                image "symbol:more"
            list id="lot" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                row
                  column flex=1 min-width=0 gap=8 padding="6px 0"
                    row align-items="center" gap=8 flex-wrap="wrap"
                      text mot(etat) font="-exact-title1" font-weight=700 flex="1 1 auto" hyphens="auto" testId="mot"
                      if etat == "toi"
                        Badge(label="Action requise", tint=some("-exact-system-orange"))
                      if etat == "panne"
                        Badge(label="Panne", tint=some("-exact-system-red"))
                    text phrase(etat) color="-exact-secondary-label" testId="phrase"
                    if etat != "pret"
                      progress value=fraction(etat) max=1 accent-color=match teinte(etat) { case some(c) => c, case none => "-exact-system-gray" } testId="barre"
                      row justify-content="space-between"
                        text `${fait(etat)} sur ${total(etat)}` font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="compte"
                        text unite(etat) font="-exact-footnote" color="-exact-secondary-label"
              if etat == "pret"
                section
                  row align-items="center" gap=12 flex-wrap="wrap"
                    text "Premier cut" flex=1
                    input value=premier input=ecrirePremier inputmode="numeric" aria-label="Premier cut" testId="premier" flex="0 1 7rem" min-width=0 text-align="right"
                  row align-items="center" gap=12 flex-wrap="wrap"
                    text "Dernier cut" flex=1
                    input value=dernier input=ecrireDernier placeholder="fin de partie" inputmode="numeric" aria-label="Dernier cut" testId="dernier" flex="0 1 7rem" min-width=0 text-align="right"
                  footer
                    text "Dernier cut vide : le lot va jusqu’à la fin de la partie, puis se clôt seul."
              section background-color="transparent"
                row
                  column flex=1 min-width=0 gap=10
                    if principale(etat) != ""
                      button press=agir buttonStyle=(attendue(etat) ? "filled" : "bordered") -exact-control-size="large" testId="principale"
                        text principale(etat)
                    if seconde(etat) != "" or arret(etat) != "" or etat == "fin" or etat == "relecture"
                      row gap=10 flex-wrap="wrap"
                        if seconde(etat) != ""
                          button buttonStyle="bordered" flex="1 1 auto" testId="seconde"
                            text seconde(etat)
                        if etat == "fin" or etat == "relecture"
                          button press=nouveau buttonStyle="bordered" flex="1 1 auto" testId="nouveau"
                            text "Nouveau lot"
                        if arret(etat) != ""
                          button press=arreter destructive=true buttonStyle="bordered" flex="1 1 auto" testId="arret"
                            text arret(etat)
                    if etat == "rattrapage"
                      text "Aucune autre action jusqu’à la fin du rattrapage." font="-exact-footnote" color="-exact-secondary-label" text-align="center" testId="verrou"
              if etat != "pret"
                section
                  RowText(title="Posés", detail="", value=some(poses(etat)))
                  RowText(title="À poser", detail=(etat == "fin" ? "à examiner" : "après le lot"), value=some(`${aPoser(etat)}`))
                section
                  header
                    text "À poser"
                  for c in cutsAPoser(etat) key=c
                    row align-items="center"
                      column flex=1 min-width=0
                        text `Cut ${c}` font-variant-numeric="tabular-nums"
                        text `Laissé à ${heure(c)}` font="-exact-footnote" color="-exact-secondary-label"
                      button testId=`ouvrir-${c}`
                        text "Ouvrir"
        if e.name == "plus"
          column navigationKey=`${e.id}` navigationScroll="plus-liste" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              button id="retour" press=retour aria-label="Retour" testId="retour"
                image "symbol:back"
              text "Plus" role="heading" flex=1
            Plus(etat=etat, choisir=choisir, nouveau=nouveau)
