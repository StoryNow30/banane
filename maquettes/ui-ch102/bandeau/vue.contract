// CH-102, proposition 3 « Le bandeau » : l'état est un aplat de couleur en tête de fenêtre, lisible de loin sans lire ;
// l'avancement est une barre et une ligne de chiffres juste dessous. La couleur ne vient que de l'état : gris au repos,
// la teinte du système au travail, orange quand Ariane attend l'opérateur, rouge en panne, vert à la fin.
use StatBar from "exact:content"
// ---
routes nav
  home "/"
    plus "/plus"

component App
  state etat = "pret"
  action agir
    etat = suite(etat)
  action arreter
    etat = "fin"
  action nouveau
    etat = "pret"
  action choisir(v: string)
    etat = v
  action ouvrirPlus
    nav = push(nav, "/plus")
  action retour
    nav = back(nav)
  action suivre(url: string)
    nav = go(nav, url)
  view
    main testId="racine" navigationKey=`${top(nav).id}` navigationBack="retour" navigate=suivre width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="lot" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              text "Ariane" role="heading" aria-level=1 flex=1
              button press=ouvrirPlus aria-label="Plus" testId="plus"
                image "symbol:more"
            scroll id="lot" flex=1 min-height=0
              column
                column gap=6 padding="28px 20px" background-color=match teinte(etat) { case some(c) => c, case none => "-exact-secondary-background" } testId="bandeau"
                  text mot(etat) font="-exact-large-title" font-weight=700 color=(etat == "pret" or etat == "pause" ? "-exact-label" : "white") testId="mot"
                  text phrase(etat) color=(etat == "pret" or etat == "pause" ? "-exact-secondary-label" : "white") testId="phrase"
                column gap=20 padding="20px" max-width="32rem"
                  if etat != "pret"
                    column accent-color=match teinte(etat) { case some(c) => c, case none => "-exact-system-gray" }
                      StatBar(label=unite(etat), value=`${fait(etat)} sur ${total(etat)}`, fraction=fraction(etat), tint=teinte(etat))
                    text `${poses(etat)} posés · ${aPoser(etat)} à poser` color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="compte"
                  row gap=10 flex-wrap="wrap"
                    if principale(etat) != ""
                      button press=agir buttonStyle="filled" -exact-control-size="large" flex="1 1 10rem" testId="principale"
                        text principale(etat)
                    if seconde(etat) != ""
                      button buttonStyle="bordered" -exact-control-size="large" flex="1 1 10rem" testId="seconde"
                        text seconde(etat)
                    if etat == "fin" or etat == "relecture"
                      button press=nouveau buttonStyle="bordered" -exact-control-size="large" flex="1 1 10rem" testId="nouveau"
                        text "Nouveau lot"
                    if arret(etat) != ""
                      button press=arreter destructive=true -exact-control-size="large" flex="1 1 10rem" testId="arret"
                        text arret(etat)
                  if etat == "rattrapage"
                    text "Aucune autre action jusqu’à la fin du rattrapage." font="-exact-footnote" color="-exact-secondary-label" testId="verrou"
        if e.name == "plus"
          column navigationKey=`${e.id}` navigationScroll="plus-liste" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              button id="retour" press=retour aria-label="Retour" testId="retour"
                image "symbol:back"
              text "Plus" role="heading" flex=1
            Plus(etat=etat, choisir=choisir, nouveau=nouveau)
