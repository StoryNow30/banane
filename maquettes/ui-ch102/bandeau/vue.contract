// CH-102, proposition 3 « Le bandeau » : l'état est un aplat de couleur en tête de fenêtre, lisible de loin sans lire ;
// l'avancement est une barre et une ligne de chiffres juste dessous. La couleur ne vient que de l'état : gris au repos,
// la teinte du système au travail, orange quand Ariane attend l'opérateur, rouge en panne, vert à la fin.
use StatBar from "exact:content"
// ---
routes nav
  home "/"
    plus "/plus"

component App
  state etat = "pret" persist
  state premier = "4790"
  state dernier = ""
  // La page de comparaison ouvre l'application sur un état précis : `/?etat=toi`.
  task ouverture mount
    after(1, lireAdresse)
  action lireAdresse
    let v = searchParam(top(nav), "etat")
    if v != ""
      etat = v
  action agir
    etat = suite(etat)
  action arreter
    etat = "fin"
  action nouveau
    etat = "pret"
  action choisir(v: string)
    etat = v
  action ecrirePremier(v: string)
    premier = v
  action ecrireDernier(v: string)
    dernier = v
  action ouvrirPlus
    nav = push(nav, "/plus")
  action retour
    nav = back(nav)
  action suivre(url: string)
    nav = go(nav, url)
  view
    main testId="racine" navigationKey=`${top(nav).id}` navigationBack="retour" navigate=suivre width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="lot" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              text "Ariane" role="heading" aria-level=1 flex=1
              button press=ouvrirPlus aria-label="Plus" testId="plus"
                image "symbol:more"
            scroll id="lot" flex=1 min-height=0
              column min-height="100%"
                if etat == "pret" or etat == "pause"
                  column gap=6 padding="24px 20px" flex="1 1 auto" max-height="17rem" justify-content="flex-end" box-sizing="border-box" background-color="-exact-secondary-background" testId="bandeau"
                    text mot(etat) font="-exact-large-title" font-weight=700 hyphens="auto" testId="mot"
                    text phrase(etat) color="-exact-secondary-label" testId="phrase"
                else
                  column gap=6 padding="24px 20px" flex="1 1 auto" max-height="17rem" justify-content="flex-end" box-sizing="border-box" accent-color=match teinte(etat) { case some(c) => c, case none => "-exact-system-gray" } background-color="AccentColor" color="AccentColorText" testId="bandeau"
                    text mot(etat) font="-exact-large-title" font-weight=700 color="AccentColorText" hyphens="auto" testId="mot"
                    text phrase(etat) color="AccentColorText" testId="phrase"
                column gap=16 padding=20 width="100%" box-sizing="border-box" flex="0 0 auto"
                  if etat == "pret"
                    column gap=12
                      row align-items="center" gap=12 flex-wrap="wrap"
                        text "Premier cut" flex=1
                        input value=premier input=ecrirePremier inputmode="numeric" aria-label="Premier cut" testId="premier" flex="0 1 7rem" min-width=0 text-align="right"
                      row align-items="center" gap=12 flex-wrap="wrap"
                        text "Dernier cut" flex=1
                        input value=dernier input=ecrireDernier placeholder="fin de partie" inputmode="numeric" aria-label="Dernier cut" testId="dernier" flex="0 1 7rem" min-width=0 text-align="right"
                  else
                    column gap=8
                      StatBar(label=unite(etat), value=`${fait(etat)} sur ${total(etat)}`, fraction=fraction(etat), tint=some(match teinte(etat) { case some(c) => c, case none => "-exact-system-gray" }))
                      text `${poses(etat)} posés · ${aPoser(etat)} à poser` font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="compte"
                  column gap=10
                    if principale(etat) != ""
                      button press=agir buttonStyle=(attendue(etat) ? "filled" : "bordered") -exact-control-size="large" testId="principale"
                        text principale(etat)
                    if seconde(etat) != "" or arret(etat) != "" or etat == "fin" or etat == "relecture"
                      row gap=10 flex-wrap="wrap"
                        if seconde(etat) != ""
                          button buttonStyle="bordered" flex="1 1 auto" testId="seconde"
                            text seconde(etat)
                        if etat == "fin" or etat == "relecture"
                          button press=nouveau buttonStyle="bordered" flex="1 1 auto" testId="nouveau"
                            text "Nouveau lot"
                        if arret(etat) != ""
                          button press=arreter destructive=true buttonStyle="bordered" flex="1 1 auto" testId="arret"
                            text arret(etat)
                    if etat == "rattrapage"
                      text "Aucune autre action jusqu’à la fin du rattrapage." font="-exact-footnote" color="-exact-secondary-label" text-align="center" testId="verrou"
        if e.name == "plus"
          column navigationKey=`${e.id}` navigationScroll="plus-liste" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              button id="retour" press=retour aria-label="Retour" testId="retour"
                image "symbol:back"
              text "Plus" role="heading" flex=1
            Plus(etat=etat, choisir=choisir, nouveau=nouveau)
