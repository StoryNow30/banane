// CH-102, proposition 3 « Le bandeau » : tant que tout va bien, l'écran reste neutre. Quand Ariane a besoin de l'opérateur,
// l'en-tête d'état devient un aplat de couleur (orange : à toi ; rouge : en panne) qui se voit de loin sans lire.
// L'avancement est un compte et une barre juste dessous ; au bas de la fenêtre, une ligne dit ce qui reste à poser.
// ---
routes nav
  home "/"
    plus "/plus"

component App
  state etat = "pret" persist
  state premier = "4790"
  state dernier = ""
  // La page de comparaison ouvre l'application sur un état précis : `/?etat=toi`.
  task ouverture mount
    after(1, lireAdresse)
  action lireAdresse
    let v = searchParam(top(nav), "etat")
    if v != ""
      etat = v
  action agir
    etat = suite(etat)
  action arreter
    etat = "fin"
  action nouveau
    etat = "pret"
  action choisir(v: string)
    etat = v
  action ecrirePremier(v: string)
    premier = v
  action ecrireDernier(v: string)
    dernier = v
  action ouvrirPlus
    nav = push(nav, "/plus")
  action retour
    nav = back(nav)
  action suivre(url: string)
    nav = go(nav, url)
  view
    main testId="racine" navigationKey=`${top(nav).id}` navigationBack="retour" navigate=suivre width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="lot" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              text "Ariane" role="heading" aria-level=2 flex=1
              button press=ouvrirPlus aria-label="Plus" testId="plus"
                image "symbol:more"
            scroll id="lot" flex=1 min-height=0
              column min-height="100%"
                if alerte(etat)
                  column gap=6 padding="20px 16px" accent-color=couleurBarre(etat) background-color="AccentColor" color="AccentColorText" testId="bandeau"
                    text mot(etat) font="-exact-large-title" font-weight=700 color="AccentColorText" hyphens="auto" testId="mot"
                    text phrase(etat) color="AccentColorText" text-wrap="balance" testId="phrase"
                else
                  column gap=6 padding="20px 16px" background-color="-exact-secondary-background" testId="bandeau"
                    text mot(etat) font="-exact-large-title" font-weight=700 hyphens="auto" testId="mot"
                    text phrase(etat) color="-exact-secondary-label" text-wrap="balance" testId="phrase"
                column gap=16 padding="16px 16px 0" flex="1 1 auto" box-sizing="border-box"
                  if etat == "pret"
                    column gap=12
                      row align-items="center" gap=12 flex-wrap="wrap"
                        text "Premier cut" flex=1
                        input value=premier input=ecrirePremier inputmode="numeric" aria-label="Premier cut" testId="premier" flex="0 1 7rem" min-width=0 text-align="right"
                      row align-items="center" gap=12 flex-wrap="wrap"
                        text "Dernier cut" flex=1
                        input value=dernier input=ecrireDernier placeholder="fin de partie" inputmode="numeric" aria-label="Dernier cut" testId="dernier" flex="0 1 7rem" min-width=0 text-align="right"
                  else
                    column gap=8
                      row align-items="baseline" gap=6 flex-wrap="wrap"
                        text fait(etat) font="-exact-title1" font-weight=700 font-variant-numeric="tabular-nums" testId="fait"
                        text `sur ${total(etat)} ${uniteMin(etat)}` color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="compte"
                      progress value=fraction(etat) max=1 width="100%" accent-color=couleurBarre(etat) aria-label=unite(etat) testId="barre"
                      text `${poses(etat)} posés · ${aPoser(etat)} à poser` font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                  column gap=10
                    if principale(etat) != ""
                      button press=agir buttonStyle=(attendue(etat) ? "filled" : "bordered") -exact-control-size="large" testId="principale"
                        text principale(etat)
                    else if arret(etat) != ""
                      button press=arreter destructive=true buttonStyle="bordered" -exact-control-size="large" testId="arret"
                        text arret(etat)
                    if seconde(etat) != "" or etat == "fin" or etat == "relecture" or (principale(etat) != "" and arret(etat) != "")
                      row gap=10 flex-wrap="wrap" align-items="center"
                        if seconde(etat) != ""
                          button buttonStyle="bordered" flex="1 1 auto" testId="seconde"
                            text seconde(etat)
                        if etat == "fin" or etat == "relecture"
                          button press=nouveau buttonStyle="bordered" flex="1 1 auto" testId="nouveau"
                            text "Nouveau lot"
                        if principale(etat) != "" and arret(etat) != ""
                          button press=arreter destructive=true buttonStyle="plain" flex="1 1 auto" testId="arret"
                            text arret(etat)
                    if etat == "rattrapage"
                      text "Aucune autre action jusqu’à la fin du rattrapage." font="-exact-footnote" color="-exact-secondary-label" text-align="center" testId="verrou"
                  view flex="1 1 0" min-height=0
                  if aPoser(etat) > 0
                    column gap=0
                      hr
                      link href=path("plus") testId="reste"
                        row align-items="center" gap=8 padding="12px 0"
                          text "À poser" flex=1 color="-exact-label"
                          text cutsMot(aPoser(etat)) color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          image "symbol:forward-chevron" color="-exact-tertiary-label" aria-hidden=true
        if e.name == "plus"
          column navigationKey=`${e.id}` navigationScroll="plus-liste" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              button id="retour" press=retour aria-label="Retour" testId="retour"
                image "symbol:back"
              text "Plus" role="heading" flex=1
            Plus(etat=etat, choisir=choisir, nouveau=nouveau)
