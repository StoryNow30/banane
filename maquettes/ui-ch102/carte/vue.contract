// CH-102, proposition 2 « La carte » : l'état en grand titre, une seule carte du système pour l'avancement, l'action attendue en bouton plein.
// Une colonne large comme un téléphone au plus, centrée dans la fenêtre : rien d'autre à l'écran, le reste est derrière « Plus ».
use SummaryCard, Badge from "exact:content"
// ---
routes nav
  home "/"
    plus "/plus"

component App
  state etat = "pret" persist
  state premier = "4790"
  state dernier = ""
  action agir
    etat = suite(etat)
  action arreter
    etat = "fin"
  action nouveau
    etat = "pret"
  action choisir(v: string)
    etat = v
  action ecrirePremier(v: string)
    premier = v
  action ecrireDernier(v: string)
    dernier = v
  action ouvrirPlus
    nav = push(nav, "/plus")
  action retour
    nav = back(nav)
  action suivre(url: string)
    nav = go(nav, url)
  view
    main testId="racine" navigationKey=`${top(nav).id}` navigationBack="retour" navigate=suivre width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="lot" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              text "Ariane" role="heading" aria-level=1 flex=1
              button press=ouvrirPlus aria-label="Plus" testId="plus"
                image "symbol:more"
            scroll id="lot" flex=1 min-height=0
              column min-height="100%" justify-content="center" padding=16 box-sizing="border-box"
                column gap=20 width="100%" max-width="24rem" margin-left="auto" margin-right="auto"
                  column gap=6
                    if etat == "toi"
                      row
                        Badge(label="Action requise", tint=some("-exact-system-orange"))
                    if etat == "panne"
                      row
                        Badge(label="Panne", tint=some("-exact-system-red"))
                    text mot(etat) font="-exact-large-title" font-weight=700 hyphens="auto" testId="mot"
                    text phrase(etat) color="-exact-secondary-label" testId="phrase"
                  if etat == "pret"
                    column gap=12 padding=16 border-radius=16 background-color="-exact-secondary-background"
                      row align-items="center" gap=12 flex-wrap="wrap"
                        text "Premier cut" flex=1
                        input value=premier input=ecrirePremier inputmode="numeric" aria-label="Premier cut" testId="premier" flex="0 1 7rem" min-width=0 text-align="right"
                      row align-items="center" gap=12 flex-wrap="wrap"
                        text "Dernier cut" flex=1
                        input value=dernier input=ecrireDernier placeholder="fin de partie" inputmode="numeric" aria-label="Dernier cut" testId="dernier" flex="0 1 7rem" min-width=0 text-align="right"
                  else
                    column accent-color=match teinte(etat) { case some(c) => c, case none => "-exact-system-gray" }
                      SummaryCard(label=unite(etat), value=fait(etat), detail=`sur ${total(etat)}`, progress=some(fraction(etat)), symbol=none)
                  column gap=10
                    if principale(etat) != ""
                      button press=agir buttonStyle=(attendue(etat) ? "filled" : "bordered") -exact-control-size="large" testId="principale"
                        text principale(etat)
                    if seconde(etat) != "" or arret(etat) != "" or etat == "fin" or etat == "relecture"
                      row gap=10 flex-wrap="wrap"
                        if seconde(etat) != ""
                          button buttonStyle="bordered" flex="1 1 auto" testId="seconde"
                            text seconde(etat)
                        if etat == "fin" or etat == "relecture"
                          button press=nouveau buttonStyle="bordered" flex="1 1 auto" testId="nouveau"
                            text "Nouveau lot"
                        if arret(etat) != ""
                          button press=arreter destructive=true buttonStyle="bordered" flex="1 1 auto" testId="arret"
                            text arret(etat)
                    if etat == "rattrapage"
                      text "Aucune autre action jusqu’à la fin du rattrapage." font="-exact-footnote" color="-exact-secondary-label" text-align="center" testId="verrou"
                  if etat != "pret"
                    text `${poses(etat)} posés · ${aPoser(etat)} à poser` font="-exact-footnote" color="-exact-secondary-label" text-align="center" font-variant-numeric="tabular-nums" testId="compte"
        if e.name == "plus"
          column navigationKey=`${e.id}` navigationScroll="plus-liste" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              button id="retour" press=retour aria-label="Retour" testId="retour"
                image "symbol:back"
              text "Plus" role="heading" flex=1
            Plus(etat=etat, choisir=choisir, nouveau=nouveau)
