{
  "manifest_version": 3,
  "name": "Ariane",
  "version": "4.9.0.1",
  "description": "Ariane pour ESV LiDAR : Écho observe ton travail, Orbite place et valide les rails d’un lot. Collecte segmentée et export compact.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://esv.lidar.altametris.xyz/rails_validation/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ouvrir Ariane 4.9.0 test 1 — V1"
  },
  "content_scripts": [
    {
      "matches": [
        "https://esv.lidar.altametris.xyz/rails_validation/*"
      ],
      "js": [
        "src/esv-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://esv.lidar.altametris.xyz/rails_validation/*"
      ],
      "js": [
        "src/early-input.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://esv.lidar.altametris.xyz/rails_validation/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "4.9.0 test 1"
}
