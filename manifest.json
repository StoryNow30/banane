{
  "manifest_version": 3,
  "name": "Vision",
  "version": "5",
  "minimum_chrome_version": "111",
  "description": "Ariane pour ESV LiDAR : Écho observe ton travail, Orbite place et valide les rails d’un lot. Collecte segmentée et export compact.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "downloads",
    "power"
  ],
  "host_permissions": [
    "https://esv.lidar.altametris.xyz/rails_validation/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/ariane-16.png",
    "32": "icons/ariane-32.png",
    "48": "icons/ariane-48.png",
    "128": "icons/ariane-128.png"
  },
  "action": {
    "default_title": "Ouvrir Vision",
    "default_icon": {
      "16": "icons/ariane-16.png",
      "32": "icons/ariane-32.png",
      "48": "icons/ariane-48.png",
      "128": "icons/ariane-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://esv.lidar.altametris.xyz/rails_validation/*"
      ],
      "js": [
        "src/esv-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://esv.lidar.altametris.xyz/rails_validation/*"
      ],
      "js": [
        "src/early-input.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://esv.lidar.altametris.xyz/rails_validation/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
