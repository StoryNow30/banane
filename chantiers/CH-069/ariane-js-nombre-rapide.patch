 /// Départage au pair : si le double est exactement au milieu de deux écritures les plus courtes qui le relisent toutes
 /// deux, garder celle dont le dernier chiffre est pair.
+/// `n × 10^q == x` exactement (x fini > 0, n ≥ 1) : arithmétique entière, sans développement décimal. Les puissances de 5 qui
+/// débordent 128 bits rendent faux à bon droit : la partie impaire d'un côté dépasserait alors celle de l'autre (< 2^60).
+fn egal_exact(x: f64, n: u64, q: i64) -> bool {
+    let b = x.to_bits();
+    let (frac, ex) = (b & ((1u64 << 52) - 1), i64::try_from((b >> 52) & 0x7ff).unwrap_or(0));
+    let (m, e) = if ex == 0 { (frac, -1074) } else { (frac | (1u64 << 52), ex - 1075) };
+    if m == 0 { return false; }
+    let puissance5 = |k: i64, base: u128| -> Option<u128> { (0..k).try_fold(base, |a, _| a.checked_mul(5)) };
+    // a·2^ea == b·2^eb, a et b non nuls
+    let meme = |a: u128, ea: i64, b: u128, eb: i64| {
+        let (ta, tb) = (i64::from(a.trailing_zeros()), i64::from(b.trailing_zeros()));
+        a >> ta == b >> tb && ea + ta == eb + tb
+    };
+    if q >= 0 {
+        // n·5^q·2^q == m·2^e
+        puissance5(q, u128::from(n)).is_some_and(|l| meme(l, q, u128::from(m), e))
+    } else {
+        // n·2^q == m·5^(−q)·2^e
+        puissance5(-q, u128::from(m)).is_some_and(|r| meme(u128::from(n), q, r, e))
+    }
+}
