index 0000000..92bac0e
--- /dev/null
+++ b/tests/ch123-hors-pool.test.cjs
@@ -0,0 +1,51 @@
+'use strict';
+/* CH-123 : rails hors du pool de la GCV2 (leviers `c123Apparie`, `c123Compagnon`, `c123Balayage`, coupés par défaut). Capture réelle du corpus
+ * des essais ; la pose de départ du rail droit est déplacée de 130 mm en travers : le vrai rail sort de la fenêtre du moteur (80 mm). */
+const { test } = require('node:test'), assert = require('node:assert/strict');
+const L1 = require('../src/gcv2-l1.js'), Sh = require('../src/gcv1-shadow.js'), L = require('../src/lot-decision.js'), O = require('../src/continuity-observer.js');
+const C = require('../vendor/capture-core.js'), { base } = require('./fixtures.cjs');
+const SIDES = ['left', 'right'];
+const cap0 = { identity: { part: 23, cut: 2855, frameId: null }, rails: base.rails, pointsSceneRelative: base.pointsSceneRelative, visibleByClipBoxes: base.visibleByClipBoxes };
+const sci0 = Sh.scientificProposeBothAvecReservoir(cap0);
+const vrai = Object.fromEntries(SIDES.map(s => [s, L.positionOf(cap0.rails[s], sci0.rails[s].next.delta)]));
+const G = 1000 * C.distance(vrai.left, vrai.right);
+const deplace = d => { const rail = cap0.rails.right, t = L.positionOf(rail, [0, sci0.rails.right.next.delta[1] + d, 0]).map((v, i) => v - rail.positionSceneRelative[i]);
+  return { ...cap0, rails: { ...cap0.rails, right: O.translated(rail, t) } }; };
+const cap = deplace(0.13), sci = Sh.scientificProposeBothAvecReservoir(cap), seul = L1.variante(cap, sci, [], L1.REGLE.lotOptions);
+const cible = Object.fromEntries(SIDES.map(s => [s, L1.decalage(cap.rails[s], vrai[s])]));
+const dmin = (h, s) => Math.min(...h.rails[s].map(x => Math.hypot(x.decal[0] - cible[s][0], x.decal[1] - cible[s][1], x.decal[2] - cible[s][2])));
+const pool = (zone = 'abords') => L1.hypothesesDuCut({ capture: cap, science: sci, seul, voisins: [], gMed: null, c123: { zone, refMm: G } });
+const sans = () => L1.hypothesesDuCut({ capture: cap, science: sci, seul, voisins: [], gMed: null });
+const avec = (l, f) => { try { L1.reglerLeviers(l); return f(); } finally { L1.reglerLeviers(null); } };
+
+test('éteint : le pool est celui d\'avant (le vrai rail droit, hors fenêtre, n\'y est pas)', () => {
+  assert.ok(Math.abs(cible.right[1]) > 120);
+  const h = pool();
+  assert.deepEqual(h.rails, sans().rails);
+  assert.ok(dmin(h, 'right') > 10);
+});
+test('c123Compagnon : le rail droit à l\'écartement de référence entre (H8), apparié, le pool d\'avant en tête', () => avec({ c123Compagnon: true }, () => {
+  const h = pool(), s0 = sans();
+  assert.ok(dmin(h, 'right') <= 10, `rail droit à ${dmin(h, 'right').toFixed(1)} mm`);
+  const g8 = h.rails.right.filter(x => x.origines.includes('H8'));
+  assert.ok(g8.length >= 1 && g8.every(x => x.sous === 'c123-compagnon'));
+  for (const s of SIDES) assert.deepEqual(h.rails[s].slice(0, s0.rails[s].length).map(x => x.decal), s0.rails[s].map(x => x.decal), 'hypothèses d\'avant gardées, même ordre');
+  /* Hors des zones du levier : rien. */
+  assert.deepEqual(avec({ c123Compagnon: true, c123Zones: ['pn'] }, () => pool().rails), s0.rails);
+}));
+test('c123Balayage : la voie balayée en travers fait entrer le rail hors fenêtre ; plafond c123MaxHyp tenu', () => avec({ c123Balayage: true, c123BalayageMm: [-130, 130], c123MaxHyp: 2 }, () => {
+  const h = pool();
+  assert.ok(dmin(h, 'right') <= 10);
+  for (const s of SIDES) assert.ok(h.rails[s].filter(x => x.origines.includes('H8') && !x.hauteur).length <= 2);
+}));
+test('appariement : sans référence d\'écartement, aucun rail généré', () => avec({ c123Compagnon: true, c123Apparie: true }, () => {
+  const h = L1.hypothesesDuCut({ capture: cap, science: sci, seul, voisins: [], gMed: null, c123: { zone: 'abords', refMm: null } });
+  assert.deepEqual(h.rails, sans().rails);
+}));
+test('c123Apparie : chaque cellule ajoutée est à c123EcartMm de la référence avec une hypothèse de l\'autre rail', () => avec({ c123Apparie: true, c123MinTop: 5 }, () => {
+  const c = deplace(0.03), sc = Sh.scientificProposeBothAvecReservoir(c), se = L1.variante(c, sc, [], L1.REGLE.lotOptions);
+  const h = L1.hypothesesDuCut({ capture: c, science: sc, seul: se, voisins: [], gMed: null, c123: { zone: 'adv', refMm: G } });
+  for (const s of SIDES) { const o = s === 'left' ? 'right' : 'left';
+    for (const x of h.rails[s].filter(y => y.origines.includes('H8') && !y.hauteur))
+      assert.ok(h.rails[o].filter(y => !y.origines.includes('H8') && !y.hauteur).some(y => Math.abs(L1.ecartementDecal(c, { [s]: x.decal, [o]: y.decal }) - G) <= 10.01)); }
+}));
