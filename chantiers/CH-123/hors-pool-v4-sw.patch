diff --git a/tests/ch123-voisin-livre-passe-sw.test.cjs b/tests/ch123-voisin-livre-passe-sw.test.cjs
new file mode 100644
index 0000000..e92f2a9
--- /dev/null
+++ b/tests/ch123-voisin-livre-passe-sw.test.cjs
@@ -0,0 +1,40 @@
+'use strict';
+/* CH-123 — `voisinLivre` DANS LA DEUXIÈME PASSE du service worker, redémarrage compris (voir tests/ch123-voisin-livre-sw.test.cjs pour le lot).
+ * Montage : tests/helpers/passe-redemarrage.cjs (deux vies du service worker). Lot 111 à 116, différés 112, 113 et 114, tous « valider » dans la
+ * passe : le 112 avec un pool d'avant SANS pose (aucune voisine), le 113 avec un pool d'avant qui validait une autre pose (2 mm plus haut : c'est
+ * elle la voisine), le 114 sans `voisinLivre` (transport livré). La vie 1 est gelée avant d'écrire la décision du 114 : la vie 2 la refait avec le
+ * transport relu de l'état de la passe. Données synthétiques. */
+const { test } = require('node:test'), assert = require('node:assert/strict');
+const { montage, bilan, CLE } = require('./helpers/passe-redemarrage.cjs');
+const SIDES = ['left', 'right'], j = x => JSON.parse(JSON.stringify(x ?? null));
+
+test('voisinLivre dans la passe : transport local et transport relu après un redémarrage, poses écrites inchangées', async () => {
+  const M = montage({ sansPoints: [112, 113, 114, 116], fin: 116 }), vus = [], poses = {};
+  const vie0 = M.vie;
+  M.vie = () => { const v = vie0(), G = v.b.ctx.BananeGcv2L1;
+    v.b.ctx.BananeGcv2L1 = { ...G, deciderDiffere: a => {
+      const cut = a.capture.identity.cut, r = G.deciderDiffere(a);
+      if (G.leviersActifs().sansVoieRien !== true || r.decision.etat !== 'valider' || ![112, 113, 114].includes(cut)) return r;
+      vus.push(j({ vie: v.n, cut, transport: (a.voisinsTransport || []).map(t => ({ cut: t.identity.cut, positions: t.positions })) }));   /* `j` : tableaux de la VM ramenés ici */
+      const autre = G.positionsDe(a.capture, Object.fromEntries(SIDES.map(s => [s, { decal: [r.decision.paire[s].decal[0], r.decision.paire[s].decal[1], r.decision.paire[s].decal[2] + 2] }])));
+      poses[cut] = { pose: j(r.positions), autre: j(autre) };
+      return cut === 112 ? { ...r, voisinLivre: { etat: 'rien', positions: null } } : cut === 113 ? { ...r, voisinLivre: { etat: 'valider', positions: autre } } : r;
+    } };
+    return v; };
+  /* Gel AVANT l'écriture de la 3e décision (114) : la vie 1 a gardé celles du 112 et du 113. */
+  M.tuer(o => o[CLE]?.phase === 'ombre' && o[CLE].index >= 3, { avant: true });
+  const v1 = await M.lot(); assert.equal(v1.gelee, true, 'vie 1 gelée pendant la passe');
+  const gardees = j(M.etat().poses);
+  assert.deepEqual(gardees.map(p => p.cut), [112, 113]);
+  assert.equal(gardees[0].voisin, null, '112 : aucune voisine, gardé dans l\'état'); assert.deepEqual(gardees[1].voisin, poses[113].autre, '113 : la pose du pool d\'avant');
+  assert.deepEqual(gardees.map(p => p.positions), [poses[112].pose, poses[113].pose], 'la pose à écrire reste la pose décidée');
+  await M.reveil(); const B = bilan(M);
+  const t = (vie, cut) => vus.filter(x => x.vie === vie && x.cut === cut).at(-1).transport;
+  assert.deepEqual(t(1, 113), [], 'vie 1 : le 112 (pool d\'avant sans pose) n\'est pas voisin du 113');
+  for (const vie of [1, 2]) { const x = t(vie, 114);
+    assert.deepEqual(x.map(p => p.cut), [113], `vie ${vie} : le 114 a le 113 pour voisin, jamais le 112`);
+    assert.deepEqual(x[0].positions, poses[113].autre, `vie ${vie} : par la pose du pool d'avant`); }
+  /* Les poses décidées sont écrites comme avant (112, 113, 114), une validation par cut. */
+  assert.deepEqual(B.ecr.filter(e => e[1] === 'ecrit').map(e => e[0]), [112, 113, 114]); assert.deepEqual(B.enPlace, { 112: 1, 113: 1, 114: 1 });
+  assert.equal(B.etat, null, 'état effacé à la fin');
+});
diff --git a/tests/ch123-voisin-livre-sw.test.cjs b/tests/ch123-voisin-livre-sw.test.cjs
