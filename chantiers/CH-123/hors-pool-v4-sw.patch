index 0000000..37f7f06
--- /dev/null
+++ b/tests/ch123-voisin-livre-sw.test.cjs
@@ -0,0 +1,44 @@
+'use strict';
+/* CH-123 — LE SERVICE WORKER BRANCHÉ COMME LE BANC SUR `voisinLivre` (leviers `c123SansRicochet`, `c123SeulementDifferes` de src/gcv2-l1.js, coupés par
+ * défaut). Quand la décision de la GCV2 porte `voisinLivre` (des hypothèses générées sont entrées au pool), la pose validée ne devient voisine de
+ * TRANSPORT que par la décision du pool d'avant : jamais si elle laissait le cut sans pose ; par SA pose si elle validait et que sa commande passe.
+ * Sans `voisinLivre` (leviers coupés) : le transport livré, inchangé. Montage : tests/helpers/lot-profil.cjs (service worker réel en VM, cuts 111 à
+ * 113, le 112 sans point ; la GCV2 est forcée à « valider » sur le 112). Données synthétiques. */
+const { test } = require('node:test'), assert = require('node:assert/strict');
+const { production, base, K, S, EsvTrou, SCOPE, attendre, decisions } = require('./helpers/lot-profil.cjs');
+const SIDES = ['left', 'right'];
+
+async function lot(voisinLivre) {
+  const adapter = new EsvTrou([]), b = production({ adapter });
+  b.ctx.BananeSettings = { ...b.ctx.BananeSettings, voiePrediteOmbre: { ...S.voiePrediteOmbre, actif: false }, deplacerVue: { ...S.deplacerVue, actif: false }, lot: { ...S.lot, gardeApresDiffere: false } };
+  const G = b.ctx.BananeGcv2L1; let pose = null, autre = null;
+  b.ctx.BananeGcv2L1 = { ...G, deciderDiffere: a => {
+    const r = G.deciderDiffere(a); if (a.capture.identity.cut !== 112) return r;
+    const p0 = b.store.events.find(e => e.type === 'gcv1-shadow-observed' && e.identity?.cut === 111)?.lotObservation?.positions;
+    const paire = { left: { decal: G.decalage(a.capture.rails.left, p0.left) }, right: { decal: G.decalage(a.capture.rails.right, p0.right) } };
+    /* La pose du pool d'avant (cas « valider ») : la même paire, levée de 2 mm (elle se distingue de la pose commandée). */
+    const paireAvant = Object.fromEntries(SIDES.map(s => [s, { decal: [paire[s].decal[0], paire[s].decal[1], paire[s].decal[2] + 2] }]));
+    pose = G.positionsDe(a.capture, paire); autre = G.positionsDe(a.capture, paireAvant);
+    const vl = voisinLivre === 'rien' ? { etat: 'rien', positions: null } : voisinLivre === 'valider' ? { etat: 'valider', positions: autre } : null;
+    return { ...r, decision: { ...r.decision, etat: 'valider', motif: null, p: 0.9, paire, hypothese: 'H8', ecartDepartMm: 1 }, positions: pose, ...(vl ? { voisinLivre: vl } : {}) };
+  } };
+  await b.api('connect', { tabId: 1 }); await b.api('settings', { mode: 'automatic-test' });
+  adapter.identity.cut = 111; adapter.rails = K.clone(base.rails); adapter.ajuster();
+  await b.api('start', { part: 23, start: 111, end: 113, ...SCOPE }); await b.settle(); await attendre(30);
+  return { b, pose, autre, transport: JSON.parse(JSON.stringify(b.get('l1eTransport'))).poses, d112: decisions(b).find(([c]) => c === 112)[1] };
+}
+const proche = (p, q) => SIDES.every(s => Math.hypot(...p[s].slice(0, 3).map((v, i) => v - q[s][i])) < 1e-9);
+
+test('voisinLivre dans le lot : la pose est commandée, mais elle ne voyage que par la décision du pool d\'avant', async () => {
+  const sans = await lot(null);
+  assert.equal(sans.d112.command.reason, 'gcv2-l1');
+  assert.deepEqual(sans.transport.map(p => p.identity.cut), [112], 'sans voisinLivre : transport livré');
+  assert.ok(proche(sans.transport[0].positions, sans.pose), 'la pose elle-même');
+  const rien = await lot('rien');
+  assert.equal(rien.d112.command.reason, 'gcv2-l1', 'la pose est toujours commandée et validée'); assert.equal(rien.d112.command.l1s, 'gcv2');
+  assert.deepEqual(rien.transport, [], 'pool d\'avant sans pose : aucune voisine (aucun ricochet)');
+  const val = await lot('valider');
+  assert.equal(val.d112.command.reason, 'gcv2-l1');
+  assert.deepEqual(val.transport.map(p => p.identity.cut), [112]);
+  assert.ok(proche(val.transport[0].positions, val.autre) && !proche(val.transport[0].positions, val.pose), 'la voisine est la pose du pool d\'avant, pas la pose commandée');
+});
