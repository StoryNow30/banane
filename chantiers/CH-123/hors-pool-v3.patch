+/* CH-123 (`c123SansRicochet`) : position que la pose de la GCV2 donne aux cuts suivants comme voisine. Sans `voisinLivre` : la pose elle-même.
+ * Avec : la décision du pool d'avant (générateurs coupés), seulement si elle validait et que sa commande passe ; sinon aucune voisine. */
+function voisinDe(g, positions, runtimeRails, before, cameras, camerasLarges) {
+  if (!g.voisinLivre) return positions;
+  if (g.voisinLivre.etat !== 'valider' || !g.voisinLivre.positions) return null;
+  const c = L1.commander({ positions: g.voisinLivre.positions, runtimeRails, before, expectedPoses: K.expectedPoses, cameras, camerasLarges, valider: true });
