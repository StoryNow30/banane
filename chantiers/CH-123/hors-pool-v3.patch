+});
+test('c123SansPaire : quand le pool a déjà une paire à l\'écartement de référence, rien n\'est généré', () => {
+  const sc = Sh.scientificProposeBothAvecReservoir(cap0), se = L1.variante(cap0, sc, [], L1.REGLE.lotOptions);
