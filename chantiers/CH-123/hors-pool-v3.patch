+ * des essais ; la pose de départ du rail droit est déplacée de 130 mm en travers : le vrai rail sort de la fenêtre du moteur (80 mm). */
+const { test } = require('node:test'), assert = require('node:assert/strict');
+const L1 = require('../src/gcv2-l1.js'), Sh = require('../src/gcv1-shadow.js'), L = require('../src/lot-decision.js'), O = require('../src/continuity-observer.js');
+const C = require('../vendor/capture-core.js'), { base } = require('./fixtures.cjs');
+const SIDES = ['left', 'right'];
+const cap0 = { identity: { part: 23, cut: 2855, frameId: null }, rails: base.rails, pointsSceneRelative: base.pointsSceneRelative, visibleByClipBoxes: base.visibleByClipBoxes };
