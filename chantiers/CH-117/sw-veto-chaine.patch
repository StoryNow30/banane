diff -ruN a/tests/ch117-veto-chaine-sw.test.cjs b/tests/ch117-veto-chaine-sw.test.cjs
--- a/tests/ch117-veto-chaine-sw.test.cjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/ch117-veto-chaine-sw.test.cjs	2026-11-12 17:29:04.845432807 +0000
@@ -0,0 +1,41 @@
+'use strict';
+/* CH-117 (C1) — LE VETO DE LA CHAÎNE dans le service worker réel (VM), profil L1-se. Montage commun : tests/helpers/lot-profil.cjs (cuts 111 à 113, le 112
+ * sans point). Le levier est coupé à la livraison : aucune commande ne change (tests/pose-lot-inchanges-4959.test.cjs et les essais lot-profil-*). Ici on
+ * l'allume en VM (leviers actifs vus par background.js) et on force son verdict sur le 113, posé par la chaîne : la pose n'est pas envoyée, le cut passe à
+ * la GCV2 comme un différé ; il ne devient pas appui. */
+const { test } = require('node:test'), assert = require('node:assert/strict');
+const { decisions, production, base, K, S, SCOPE, EsvTrou, attendre } = require('./helpers/lot-profil.cjs');
+
+async function lot({ allume, veto }) {
+  const adapter = new EsvTrou([]), b = production({ adapter });
+  b.ctx.BananeSettings = { ...b.ctx.BananeSettings, voiePrediteOmbre: { ...S.voiePrediteOmbre, actif: false }, deplacerVue: { ...S.deplacerVue, actif: false }, lot: { ...S.lot, gardeApresDiffere: false } };
+  const G = b.ctx.BananeGcv2L1, appels = [], gcv2 = [];
+  b.ctx.BananeGcv2L1 = { ...G,
+    leviersActifs: () => allume ? { ...G.leviersActifs(), vetoChaineVoieMm: 100, vetoChaineZones: ['abords', 'adv'] } : G.leviersActifs(),
+    vetoChaine: (capture, cut, voisins, decal, zone) => { appels.push({ cut, zone, voisins: voisins.map(v => v.identity.cut) }); return cut === 113 && veto ? { ecartMm: 150, veto: true } : { ecartMm: 0, veto: false }; },
+    deciderDiffere: a => { gcv2.push(a.capture.identity.cut); return G.deciderDiffere(a); } };
+  await b.api('connect', { tabId: 1 }); await b.api('settings', { mode: 'automatic-test' });
+  adapter.identity.cut = 111; adapter.rails = K.clone(base.rails); adapter.ajuster();
+  await b.api('start', { part: 23, start: 111, end: 113, ...SCOPE }); await b.settle(); await attendre(30);
+  return { b, appels, gcv2 };
+}
+
+test('C1 coupé : le veto n\'est jamais demandé', async () => {
+  const x = await lot({ allume: false, veto: true });
+  assert.equal(x.appels.length, 0);
+  const d113 = decisions(x.b).find(([c]) => c === 113)[1];
+  assert.notEqual(d113.command.action, 'defer', '113 posé par la chaîne');
+});
+
+test('C1 allumé : pose de la chaîne contredite par la voie des voisins → différé, GCV2, pas d\'appui ; sans veto, rien ne change', async () => {
+  const sans = await lot({ allume: true, veto: false });
+  const s113 = decisions(sans.b).find(([c]) => c === 113)[1];
+  assert.ok(sans.appels.some(a => a.cut === 113), 'le veto est demandé sur la pose de la chaîne');
+  assert.notEqual(s113.command.action, 'defer');
+  const x = await lot({ allume: true, veto: true });
+  const d113 = decisions(x.b).find(([c]) => c === 113)[1];
+  assert.equal(d113.vetoChaine.veto, true); assert.equal(d113.vetoChaine.ecartMm, 150);
+  assert.ok(x.gcv2.includes(113), 'la GCV2 décide le 113');
+  assert.ok(d113.command.action === 'defer' || d113.command.l1s === 'gcv2', 'jamais la pose de la chaîne');
+  assert.notEqual(d113.anchorHeld, true, 'pas un appui');
+});
