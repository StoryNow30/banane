--- a/tests/ch117-voie-adv.test.cjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/ch117-voie-adv.test.cjs	2026-11-12 17:29:04.827986496 +0000
@@ -0,0 +1,69 @@
+'use strict';
+/* CH-117 (D-351) — la mauvaise voie à sa source, en zone d'aiguillage. Trois leviers de src/gcv2-l1.js, tous COUPÉS par défaut (la v6 livrée ne change pas) :
+ *  - C1 `vetoChaine` (`vetoChaineVoieMm`, `vetoChaineZones`, `vetoChaineMaxCuts`) : garde de voie absolue sur la pose de la CHAÎNE ;
+ *  - C2 `sousTauVoieZones` (`sousTauVoieMm`, `sousTauVoieMaxCuts`) : sous τ « cohérent » exige une voie de voisins qui s'accorde ;
+ *  - C5 `vetoVoieAbsMaxCuts` : la garde de voie absolue de la GCV2, avec un voisin au-delà de `rechProcheMaxCuts`.
+ * Cas fabriqués sur la capture réelle d'essai (tests/fixtures.cjs), comme tests/gcv2-l1-fautes.test.cjs. */
+const { test } = require('node:test'), assert = require('node:assert/strict');
+const L1 = require('../src/gcv2-l1.js'), L = require('../src/lot-decision.js'), { base } = require('./fixtures.cjs');
+
+const h = (decal, origines, g) => ({ rang: 0, hauteur: false, origines, sousOrigines: [], decal, g, x: null });
+const cas = (voisinsAbs, voieProche = null) => ({ cut: 4, zone: 'adv', gMed: 1450, G0: 1500, voieRef: null, voieProche, i0: { left: 0, right: 0 }, voisinsAbs,
+  rails: { left: { hyps: [h([0, 0, 0], ['H0'], 1450), h([0, -36, 5], ['H1'], 1486)] }, right: { hyps: [h([0, 0, 0], ['H0'], 1450), h([0, 20, 5], ['H2'], 1470)] } } });
+const MOD = tau => ({ seuils: { adv: { actif: true, tau, delta: 2 }, hors: { actif: true, tau, delta: 3 } } });
+const PR = { left: [0.2, 0.9], right: [0.2, 0.9] };
+const G = L1.ecartementDecal(base, { left: [0, -36, 5], right: [0, 20, 5] });
+const voisin = (c, lat) => ({ identity: { part: 1, cut: c, frameId: null },
+  positions: Object.fromEntries(['left', 'right'].map(s => [s, L.positionOf(base.rails[s], [c - 4, lat[s] / 1000, 5 / 1000])])) });
+const sous = (lev, k) => { L1.reglerLeviers(lev); try { return k(); } finally { L1.reglerLeviers(null); } };
+const decider = (k, tau, lev) => sous(lev, () => L1.deciderL1e(k, MOD(tau), { mm: G }, base, PR));
+const POSE = { left: [0, -36, 5], right: [0, 20, 5] };
+const ligne = (cuts, dl) => cuts.map(c => voisin(c, { left: -36 + dl, right: 20 + dl }));
+
+test('CH-117 : les leviers sont coupés dans la v4 et dans la v6 livrée', () => {
+  for (const k of ['vetoChaineVoieMm', 'vetoChaineZones', 'vetoChaineMaxCuts', 'sousTauVoieZones', 'vetoVoieAbsMaxCuts']) {
+    assert.equal(L1.LEVIERS_V4[k], null, k); assert.equal(L1.LEVIERS_LIVRES[k], null, k); }
+  assert.equal(L1.LEVIERS_LIVRES.vetoChaineSansVoisin, false);
+  assert.equal(L1.vetoChaine(base, 4, ligne([1, 2, 3], 150), POSE, 'adv'), null, 'coupé : rien, même à 150 mm');
+});
+
+test('C1 vetoChaine : pose de la chaîne loin de la droite des voisins validés, en zone seulement', () => {
+  const lev = { vetoChaineVoieMm: 100, vetoChaineZones: ['adv'] };
+  sous(lev, () => {
+    assert.deepEqual(L1.vetoChaine(base, 4, ligne([1, 2, 3], 0), POSE, 'adv'), { ecartMm: 0, veto: false }, 'voisins sur la pose');
+    assert.equal(L1.vetoChaine(base, 4, ligne([1, 2, 3], 80), POSE, 'adv').veto, false, '80 mm : sous le seuil');
+    const v = L1.vetoChaine(base, 4, ligne([1, 2, 3], 150), POSE, 'adv');
+    assert.equal(v.veto, true); assert.equal(v.ecartMm, 150);
+    assert.equal(L1.vetoChaine(base, 4, ligne([1, 2, 3], 150), POSE, 'abords'), null, 'hors des zones : rien');
+    assert.equal(L1.vetoChaine(base, 4, [], POSE, 'adv'), null, 'sans voisin : rien');
+    assert.equal(L1.vetoChaine(base, 4, ligne([-3], 150), POSE, 'adv'), null, 'voisin à 7 cuts : hors de portée');
+  });
+  sous({ ...lev, vetoChaineMaxCuts: 8 }, () => {
+    assert.equal(L1.vetoChaine(base, 4, ligne([-3], 150), POSE, 'adv').veto, true, 'portée 8 : le voisin à 7 cuts tranche');
+    assert.equal(L1.vetoChaine(base, 4, ligne([-5], 150), POSE, 'adv'), null, 'voisin à 9 cuts : rien');
+    assert.equal(L1.vetoChaine(base, 4, ligne([1, 2, 3], 80), POSE, 'adv').veto, false, 'à portée normale, la portée élargie ne change rien');
+  });
+});
+
+test('C2 sousTauVoieZones : sous τ cohérent en ADV, seulement avec une voie de voisins qui s\'accorde', () => {
+  const tau = 0.95;   /* p = 0,9 < τ : la test 13 pose sans valider, l'écartement est celui de la référence : « sous-tau-coherent » */
+  assert.equal(decider(cas(null), tau, null).motif, 'sous-tau-coherent', 'levier coupé : validé sans voisin');
+  const lev = { sousTauVoieZones: ['adv'] };
+  assert.notEqual(decider(cas(null), tau, lev).motif, 'sous-tau-coherent', 'sans voie : pas de sous-τ cohérent');
+  const proche = (dl, dist) => ({ left: [-36 + dl, 5], right: [20 + dl, 5], dist });
+  assert.equal(decider(cas(null, proche(10, 2)), tau, lev).motif, 'sous-tau-coherent', 'voisin posé à 2 cuts, à 10 mm : validé');
+  assert.notEqual(decider(cas(null, proche(60, 2)), tau, lev).motif, 'sous-tau-coherent', 'voisin à 60 mm en travers : pas d\'accord');
+  assert.notEqual(decider(cas(null, proche(10, 7)), tau, lev).motif, 'sous-tau-coherent', 'voisin à 7 cuts : trop loin');
+  const k = cas(null); k.zone = 'abords';
+  assert.equal(decider(k, tau, lev).motif, 'sous-tau-coherent', 'hors des zones : inchangé');
+});
+
+test('C5 vetoVoieAbsMaxCuts : la garde de voie absolue de la GCV2 tranche avec un voisin à 7-8 cuts', () => {
+  const tau = 0.44, loin = ligne([-3], 150);
+  assert.equal(decider(cas(loin), tau, { vetoVoieAbsMm: 100 }).etat, 'valider', 'garde livrée : voisin à 7 cuts, elle se tait');
+  const d = decider(cas(loin), tau, { vetoVoieAbsMm: 100, vetoVoieAbsMaxCuts: 8 });
+  assert.equal(d.etat, 'rien'); assert.equal(d.motif, 'veto-voie-absolue-loin');
+  assert.equal(decider(cas(ligne([-3], 40)), tau, { vetoVoieAbsMm: 100, vetoVoieAbsMaxCuts: 8 }).etat, 'valider', 'voisin à 40 mm : posée');
+  assert.equal(decider(cas(ligne([-5], 150)), tau, { vetoVoieAbsMm: 100, vetoVoieAbsMaxCuts: 8 }).etat, 'valider', 'voisin à 9 cuts : rien ne change');
+  assert.equal(decider(cas(ligne([1, 2, 3], 150)), tau, { vetoVoieAbsMm: 100, vetoVoieAbsMaxCuts: 8 }).motif, 'veto-voie-absolue', 'à portée normale : la garde livrée');
+});
