+'use strict';
+/* CH-125 (D-352) — la mesure de pose à la source, niveau 2 : le TRAVERS d'une pose de la GCV2 que rien n'a mesurée sur le nuage du cut.
+ *
+ * Levier `flancSource` de la décision L1-e (src/gcv2-l1.js), ABSENT des leviers livrés : sans lui, la décision est celle d'avant, octet pour octet.
+ * Réglé par le banc (`reglerLeviers({ flancSource: { seuilMm, maxMm } })`) : le flanc de chaque rail de la paire VALIDÉE est relu à sa pose, fenêtre
+ * centrée sur elle, par la mesure du calage de convention (médiane du flanc − 2,6 mm, 6 points au moins). S'il contredit la pose d'au moins
+ * `seuilMm`, il est suivi en point fixe et le rail prend sa place, à `maxMm` au plus. L'écartement de la paire mesurée est libre dans le contrat
+ * (1 420 à 1 470 mm), jamais plus loin du contrat que la paire reçue. La hauteur n'est pas touchée, l'état du cut non plus. Fixtures synthétiques.
+ * Mode `ecrite` : la décision garde sa paire (voisins et transport inchangés), la paire mesurée est rendue à part pour la seule écriture (banc, service worker). */
+const { test } = require('node:test'), assert = require('node:assert/strict');
+const L1 = require('../src/gcv2-l1.js');
+
+const C = require('../vendor/capture-core.js'), tr = t => C.translation(t);
+/* Deux rails au champignon rectangulaire (dessus z = 0 sur 64 mm, flanc côté voie en u = 0 jusqu'à −40 mm), face à face : le gauche en y = 0,
+ * champignon vers +y ; le droit en y = −écartement, champignon vers −y. Points : un dessus de 40 points à z = 0 ± 2 mm, un flanc de 11 points
+ * autour de `flanc` mm (± 2 mm) du flanc du gabarit, vers le champignon ; `flanc2` ajoute une deuxième nappe (rail voisin, lame). */
+const Conv = require('../src/placement-convention.js');
+function paire({ ecartement = 1435, gauche = {}, droite = {} } = {}) {
+  const points = [], rails = {};
+  for (const [cote, s, y0, o] of [['left', 1, 0, gauche], ['right', -1, -ecartement / 1000, droite]]) {
+    const contour = [];
+    for (let u = 0; u <= .064 + 1e-12; u += .001) contour.push([0, y0 + s * u, 0]);
+    for (let z = -.001; z >= -.04 - 1e-12; z -= .001) contour.push([0, y0, z]);
+    const M = tr([0, y0, 0]);
+    rails[cote] = { positionSceneRelative: [0, y0, 0], profileOriginSceneRelative: [0, y0, 0], railLocalToSceneRelative: M, profileLocalToSceneRelative: M,
+      sceneRelativeToProfileLocal: tr([0, -y0, 0]), profileContours: [{ verticesSceneRelative: contour }] };
+    /* `decale` : tout le nuage du rail déplacé de tant de mm vers son champignon (le rail réel est loin de la pose de départ) */
+    const dy = (o.decale || 0) / 1000;
+    for (let i = 0; i < 40; i++) points.push([0, y0 + s * (dy + .015 + i * .035 / 39), (-2 + i * 4 / 39) / 1000]);
+    const nappe = (centre, n) => { for (let i = 0; i < n; i++) points.push([0, y0 + s * (dy + (centre - 2 + i * 4 / Math.max(1, n - 1)) / 1000), -.012 - i * .02 / Math.max(1, n - 1)]); };
+    nappe(o.flanc ?? 2.6, o.points ?? 11);
+    if (o.flanc2 !== undefined) nappe(o.flanc2, o.points2 ?? 11);
+  }
+  return { rails, pointsSceneRelative: points, visibleByClipBoxes: points.map(() => true) };
+}
+const S = { seuilMm: 5, maxMm: 20 }, zero = () => ({ left: [0, 0, 0], right: [0, 0, 0] });
+const proche = (a, b, tol = 0.11) => assert.ok(Math.abs(a - b) <= tol, `${a} ≈ ${b}`);
+
+test('le levier est absent des leviers livrés : coupé par défaut, liste des leviers inchangée', () => {
+  assert.equal(L1.LEVIERS_LIVRES.flancSource, undefined);
+  assert.equal(L1.LEVIERS_V4.flancSource, undefined);
+  assert.equal(L1.leviersActifs().flancSource, undefined);
+  assert.equal(typeof L1.flancALaPose, 'function');
+  assert.equal(typeof L1.mesurerFlancPaire, 'function');
+});
+
+test('flanc à la pose : en accord sous le seuil, suivi au-delà, des deux côtés de la voie', () => {
+  /* le flanc des points à 2,6 mm du gabarit : c'est la convention, la pose et le flanc s'accordent */
+  const accord = L1.flancALaPose(paire(), 'left', [0, 0, 0], S);
+  assert.equal(accord.duMm, null); proche(accord.premierMm, 0);
+  /* flanc à 6 mm : premier pas de 3,4 mm, sous le seuil de 5 : rien */
+  const sous = L1.flancALaPose(paire({ gauche: { flanc: 6 } }), 'left', [0, 0, 0], S);
+  assert.equal(sous.duMm, null); proche(sous.premierMm, 3.4);
+  /* le flanc contredit la pose de 8 mm vers le champignon, ou de 9 mm vers la voie : le rail va au flanc */
+  for (const d of [8, -9]) {
+    const g = L1.flancALaPose(paire({ gauche: { flanc: 2.6 + d } }), 'left', [0, 0, 0], S);
+    proche(g.duMm, d); proche(g.latMm, d); assert.equal(g.depart, 'bande');
+    /* rail droit : le champignon est vers −y, le décalage latéral est de signe opposé */
+    const r = L1.flancALaPose(paire({ droite: { flanc: 2.6 + d } }), 'right', [0, 0, 0], S);
+    proche(r.duMm, d); proche(r.latMm, -d);
+  }
+  /* la fenêtre suit la pose : un rail décidé à 200 mm de son départ est mesuré là où il est, alors que la fenêtre du calage livré (180 mm
+   * autour du départ) n'y lit aucun point */
+  const loin = paire({ gauche: { decale: 200, flanc: 2.6 + 8 } });
+  assert.equal(Conv.bandOffsets(loin, 'left', [0, .2, 0]).face.length, 0, 'calage livré : aucun point de flanc lu à 200 mm du départ');
+  const f = L1.flancALaPose(loin, 'left', [0, 200, 0], S);
+  proche(f.duMm, 8); proche(f.latMm, 208);
+});
+
+test('flanc à la pose : départ large quand la bande est vide, borne, nappe double', () => {
+  /* flanc à 17 mm : la bande de 12 mm de la convention est vide ; la bande large le trouve, puis le suivi le cale (14,4 mm) */
+  const large = L1.flancALaPose(paire({ gauche: { flanc: 17 } }), 'left', [0, 0, 0], S);
+  assert.equal(large.depart, 'large'); proche(large.duMm, 14.4);
+  /* au-delà de la borne : rien */
+  assert.equal(L1.flancALaPose(paire({ gauche: { flanc: 30 } }), 'left', [0, 0, 0], S).duMm, null);
+  assert.equal(L1.flancALaPose(paire({ gauche: { flanc: 17 } }), 'left', [0, 0, 0], { seuilMm: 5, maxMm: 12 }).duMm, null, 'borne de 12 mm : le flanc à 14,4 mm est hors de portée');
+  /* deux nappes à 5 mm de part et d'autre (rail et lame) : la médiane tombe entre les deux, le premier pas est sous le seuil, la pose est gardée */
+  const double = L1.flancALaPose(paire({ gauche: { flanc: 2.6 + 5, flanc2: 2.6 - 5 } }), 'left', [0, 0, 0], S);
+  assert.equal(double.duMm, null);
+  /* la lame domine (13 points à 9 mm vers la voie) mais la pose garde son flanc (9 points là où la convention l'attend, plus du tiers) : pose gardée */
+  const lame = L1.flancALaPose(paire({ gauche: { flanc: 2.6, points: 9, flanc2: 2.6 - 9, points2: 13 } }), 'left', [0, 0, 0], S);
+  assert.equal(lame.duMm, null); assert.equal(lame.motif, 'pose-appuyee'); proche(lame.premierMm, -9, 2.1);
+  /* la pose n'a presque plus de flanc à elle (4 points sur 17) : le flanc voisin est suivi */
+  const seul = L1.flancALaPose(paire({ gauche: { flanc: 2.6, points: 4, flanc2: 2.6 - 9, points2: 13 } }), 'left', [0, 0, 0], S);
+  assert.ok(seul.duMm < -5 && seul.duMm > -11.1, JSON.stringify(seul));
+  /* moins de 6 points de flanc, même en bande large : rien */
+  assert.equal(L1.flancALaPose(paire({ gauche: { flanc: 11.6, points: 5 } }), 'left', [0, 0, 0], S).duMm, null);
+});
+
+test('paire mesurée : écartement libre dans le contrat, jamais plus loin du contrat que la paire reçue ; hauteur intacte', () => {
