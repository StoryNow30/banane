diff --git a/tests/ch125-mesure-source.test.cjs b/tests/ch125-mesure-source.test.cjs
new file mode 100644
index 0000000..ad838dd
--- /dev/null
+++ b/tests/ch125-mesure-source.test.cjs
@@ -0,0 +1,95 @@
+'use strict';
+/* CH-125 (D-352) — la mesure de pose à la source, niveau 1 : la hauteur d'un rail que le calage de convention REFUSE pour sa seule hauteur.
+ *
+ * Réglage `conventionSource` de src/settings.js, COUPÉ par défaut (`null`). Coupé : `calibrate` rend, octet pour octet, la référence figée de la
+ * base 5.0 (tests/corpus/p1-convention-reference.json). Allumé (`{ cMm, epMaxMm, dzMaxMm }`) : un rail refusé parce que |dz| dépasse 8 mm, avec
+ * |du| dans le domaine, reçoit la MÉDIANE du dessus + cMm (point fixe : la bande suit la pose), si le dessus est une nappe (épaisseur q90 − q10 au
+ * plus `epMaxMm`) et si le déplacement total reste sous `dzMaxMm` ; le flanc est relu à la hauteur corrigée, règle et constante du livré. Le motif
+ * reste `shift-out-of-domain` (la garde de paire, D-044, le lit toujours). Tout le reste est rendu à l'identique. Fixtures synthétiques seulement. */
+const {test}=require('node:test'),assert=require('node:assert/strict');
+const fs=require('node:fs'),path=require('node:path');
+const Convention=require('../src/placement-convention.js'),Settings=require('../src/settings.js'),L=require('../src/lot-decision.js');
+const {capture,raw,CAS,lancer}=require('./helpers/p1-convention-cas.cjs');
+const reference=JSON.parse(fs.readFileSync(path.join(__dirname,'corpus','p1-convention-reference.json'),'utf8')).resultats;
+const REGLAGE={cMm:4.4,epMaxMm:15,dzMaxMm:13};
+
+function avecReglage(valeur,fn){
+  const avant=Object.getOwnPropertyDescriptor(globalThis,'BananeSettings');
+  globalThis.BananeSettings={conventionSource:valeur};
+  try{return fn();}finally{if(avant)Object.defineProperty(globalThis,'BananeSettings',avant);else delete globalThis.BananeSettings;}
+}
+const mediane=v=>{const s=v.slice().sort((a,b)=>a-b),n=s.length,m=n>>1;return n%2?s[m]:(s[m-1]+s[m])/2;};
+/* Refusé pour sa seule hauteur, au domaine du cas (8 mm, ou l'option `maxShiftMm` du cas). */
+const domaine=c=>(c&&c.options&&c.options.maxShiftMm)||8;
+const refuseEnHauteur=(r,c)=>r.reason==='shift-out-of-domain'&&r.applied===false&&Math.abs(r.dzMm)>domaine(c)&&Math.abs(r.duMm)<=domaine(c);
+
+test('le réglage existe et il est coupé par défaut',()=>{
+  assert.ok('conventionSource' in Settings);
+  assert.equal(Settings.conventionSource,null);
+});
+
+test('coupé : octet pour octet la base 5.0, sur tous les cas synthétiques',()=>{
+  assert.ok(reference.map((s,i)=>[JSON.parse(s),CAS[i]]).filter(([r,c])=>refuseEnHauteur(r,c)).length>=10,'le jeu contient des rails refusés pour leur seule hauteur');
+  for(const [nom,v] of [['null',null],['faux',false],['vrai sans réglage',true],['borne sous le domaine',{...REGLAGE,dzMaxMm:3}],['borne au-delà de 20 mm',{...REGLAGE,dzMaxMm:40}],['constante illisible',{...REGLAGE,cMm:'4'}]]){
+    const out=avecReglage(v,()=>lancer(Convention));
+    for(let i=0;i<CAS.length;i++)assert.equal(out[i],reference[i],`${nom} : ${CAS[i].nom}`);
+  }
+  assert.deepEqual(lancer(Convention),reference,'sans réglage global');
+  /* Option explicite nulle : coupé même quand le réglage global est allumé. */
+  const force=avecReglage(REGLAGE,()=>CAS.map(c=>JSON.stringify(Convention.calibrate(capture(c.cap||{}),c.side||'left',raw(!!(c.cap&&c.cap.mirror)),{...(c.options||{}),source:null}))));
+  for(let i=0;i<CAS.length;i++)assert.equal(force[i],reference[i],`option source:null : ${CAS[i].nom}`);
+});
+
+test('allumé : tout rail qui n\'est pas refusé pour sa seule hauteur est rendu à l\'identique',()=>{
+  const actif=avecReglage(REGLAGE,()=>lancer(Convention));let n=0;
+  for(let i=0;i<CAS.length;i++){const ref=JSON.parse(reference[i]);if(refuseEnHauteur(ref,CAS[i]))continue;assert.equal(actif[i],reference[i],CAS[i].nom);n++;}
+  assert.ok(n>60,'cas dans le domaine, non calables et refusés en travers couverts');
+});
+
+test('allumé : un rail refusé pour sa seule hauteur va à la médiane du dessus + c, ou reste refusé tel quel',()=>{
+  const actif=avecReglage(REGLAGE,()=>lancer(Convention));let poses=0,gardes=0;
+  for(let i=0;i<CAS.length;i++){
+    const ref=JSON.parse(reference[i]);if(!refuseEnHauteur(ref,CAS[i]))continue;
+    const r=JSON.parse(actif[i]),c=CAS[i],mirror=!!(c.cap&&c.cap.mirror),brut=raw(mirror);
+    if(!r.applied){assert.equal(actif[i],reference[i],`resté refusé à l'identique : ${c.nom}`);gardes++;continue;}
+    poses++;
+    assert.equal(r.reason,'shift-out-of-domain',c.nom);assert.equal(r.source,'hauteur-mediane',c.nom);
+    assert.equal(r.dzMm,ref.dzMm,'dzMm reste le décalage mesuré par le calage livré');assert.equal(r.duMm,ref.duMm);
+    assert.ok(Math.abs(r.appliedDzMm)<=REGLAGE.dzMaxMm+1e-9,`déplacement borné : ${c.nom}`);
+    assert.ok(Math.abs(r.delta[2]-brut[2]-r.appliedDzMm/1000)<1e-12&&Math.abs(Math.abs(r.delta[1]-brut[1])-Math.abs(r.appliedDuMm)/1000)<1e-12,'le delta rendu est le brut + ce qui est appliqué');
+    assert.deepEqual(r.rawDelta,brut);
+    /* point fixe : à la pose rendue, la médiane du dessus est à cMm sous le dessus du gabarit */
+    const b=Convention.bandOffsets(capture(c.cap||{}),c.side||'left',[r.delta[0],brut[1],r.delta[2]],c.options);
+    assert.ok(Math.abs(mediane(b.top)+REGLAGE.cMm)<0.5,`médiane + c nulle à la pose : ${c.nom} (${mediane(b.top)})`);
+    assert.ok(r.sourceMm.epMm<=REGLAGE.epMaxMm);
+  }
+  assert.ok(poses>=6,`des rails refusés sont posés (${poses})`);assert.ok(gardes>=1,`des rails restent refusés par les gardes (${gardes})`);
+});
+
+test('allumé : valeurs attendues sur un dessus uniforme, et flanc relu à la hauteur corrigée',()=>{
+  /* 41 points de dessus de +6 à +12 mm au-dessus du gabarit brut : q90 + 1 = 12,4 mm (refusé) ; médiane 9 mm ; pose = 9 + 4,4 = 13,4 mm : au-delà de 13. */
+  const loin=capture({topPoints:41,topSpreadMm:3,topShiftMm:9}),refL=Convention.calibrate(loin,'left',raw(false));
+  assert.equal(refL.reason,'shift-out-of-domain');
+  assert.equal(JSON.stringify(avecReglage(REGLAGE,()=>Convention.calibrate(loin,'left',raw(false)))),JSON.stringify(refL),'au-delà de dzMaxMm : refusé comme avant');
+  /* de +3 à +9 mm : q90 + 1 = 9,4 (refusé) ; médiane 6 ; pose = 10,4 mm. */
+  const cap=capture({topPoints:41,topSpreadMm:3,topShiftMm:6}),ref=Convention.calibrate(cap,'left',raw(false));
+  assert.equal(ref.reason,'shift-out-of-domain');assert.equal(ref.applied,false);
+  const r=avecReglage(REGLAGE,()=>Convention.calibrate(cap,'left',raw(false)));
+  assert.equal(r.applied,true);assert.ok(Math.abs(r.appliedDzMm-10.4)<0.06,`dz appliqué ${r.appliedDzMm}`);
+  /* Le flanc est RELU à la hauteur corrigée : mêmes points que `bandOffsets` à cette hauteur, médiane du livré, constante du livré (−2,6 mm). */
+  const haut=Convention.bandOffsets(cap,'left',[0,raw(false)[1],raw(false)[2]+r.appliedDzMm/1000]);
+  assert.equal(r.sourceMm.faceN,haut.face.length);assert.ok(haut.face.length>=6&&haut.face.length<ref.faceN,'moins de points de flanc à la hauteur corrigée qu\'à la hauteur brute');
+  assert.ok(Math.abs(r.appliedDuMm-(Convention.quantile(haut.face,.5)-2.6))<1e-9,`du appliqué ${r.appliedDuMm}`);
+  /* Sous 6 points de flanc à la hauteur corrigée : aucune correction latérale, comme le livré. */
+  const peu=capture({topPoints:41,topSpreadMm:3,topShiftMm:6,facePoints:4}),r3=avecReglage(REGLAGE,()=>Convention.calibrate(peu,'left',raw(false)));
+  assert.equal(r3.applied,true);assert.ok(r3.sourceMm.faceN<6);assert.equal(r3.appliedDuMm,0);assert.equal(r3.delta[1],raw(false)[1]);
+});
+
+test('allumé : la garde de paire lit toujours le motif hors domaine',()=>{
+  const cap=capture({topPoints:41,topSpreadMm:3,topShiftMm:6}),cal=avecReglage(REGLAGE,()=>Convention.calibrate(cap,'left',raw(false)));
+  assert.equal(cal.applied,true);
+  const science={rails:{left:{next:{changed:true},conventionCalibration:cal},right:{next:{changed:false},conventionCalibration:null}}};
+  assert.equal(science.rails.left.conventionCalibration.reason,'shift-out-of-domain');
+  assert.equal(['left','right'].some(s=>science.rails[s].next.changed===true)&&['left','right'].some(s=>science.rails[s].conventionCalibration?.reason==='shift-out-of-domain'),true);
+  assert.ok(typeof L.decideCut==='function');
+});
