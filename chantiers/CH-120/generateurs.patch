--- /dev/null
+++ b/tests/ch120-generateurs.test.cjs
@@ -0,0 +1,62 @@
+'use strict';
+/* CH-120 : générateurs d'hypothèses de la GCV2 (leviers `genEcartement`, `genVoie`, `genLargeMm`, coupés par défaut). Capture réelle du corpus
+ * des essais ; la pose de départ du rail droit est déplacée de 130 mm en travers : le vrai rail sort de la fenêtre du moteur (80 mm). */
+const { test } = require('node:test'), assert = require('node:assert/strict');
+const L1 = require('../src/gcv2-l1.js'), Sh = require('../src/gcv1-shadow.js'), L = require('../src/lot-decision.js'), O = require('../src/continuity-observer.js');
+const C = require('../vendor/capture-core.js'), { base } = require('./fixtures.cjs');
+const SIDES = ['left', 'right'];
+const cap0 = { identity: { part: 23, cut: 2855, frameId: null }, rails: base.rails, pointsSceneRelative: base.pointsSceneRelative, visibleByClipBoxes: base.visibleByClipBoxes };
+const sci0 = Sh.scientificProposeBothAvecReservoir(cap0);
+const vrai = Object.fromEntries(SIDES.map(s => [s, L.positionOf(cap0.rails[s], sci0.rails[s].next.delta)]));
+const G = 1000 * C.distance(vrai.left, vrai.right);
+const rail = cap0.rails.right, t = L.positionOf(rail, [0, sci0.rails.right.next.delta[1] + 0.13, 0]).map((v, i) => v - rail.positionSceneRelative[i]);
+const cap = { ...cap0, rails: { ...cap0.rails, right: O.translated(rail, t) } };
+const sci = Sh.scientificProposeBothAvecReservoir(cap);
+const seul = L1.variante(cap, sci, [], L1.REGLE.lotOptions);
+const cible = Object.fromEntries(SIDES.map(s => [s, L1.decalage(cap.rails[s], vrai[s])]));
+const dmin = (h, s) => Math.min(...h.rails[s].map(x => Math.hypot(x.decal[0] - cible[s][0], x.decal[1] - cible[s][1], x.decal[2] - cible[s][2])));
+const pool = () => L1.hypothesesDuCut({ capture: cap, science: sci, seul, voisins: [], gMed: null, gen: { zone: 'adv', refMm: G } });
+
+test('éteint : le pool est celui d\'avant (le vrai rail droit, hors fenêtre, n\'y est pas)', () => {
+  assert.ok(Math.abs(cible.right[1]) > 120, 'le vrai rail droit est à plus de 120 mm du départ');
+  const h = pool(), sans = L1.hypothesesDuCut({ capture: cap, science: sci, seul, voisins: [], gMed: null });
+  assert.deepEqual(h.rails, sans.rails, 'gen sans levier = pool d\'avant');
+  assert.ok(dmin(h, 'right') > 10);
+  assert.ok(!h.rails.right.some(x => x.origines.includes('H7')));
+});
+test('genEcartement : l\'autre rail à l\'écartement de référence entre dans le pool (H7), le pool d\'avant reste en tête', () => {
+  try {
+    L1.reglerLeviers({ genEcartement: true });
+    const h = pool(), sans = L1.hypothesesDuCut({ capture: cap, science: sci, seul, voisins: [], gMed: null });
+    assert.ok(dmin(h, 'right') <= 10, `rail droit à ${dmin(h, 'right').toFixed(1)} mm`);
+    const g7 = h.rails.right.filter(x => x.origines.includes('H7'));
+    assert.ok(g7.length >= 1 && g7.every(x => x.sous.startsWith('g-ecart-left')));
+    for (const s of SIDES) assert.deepEqual(h.rails[s].slice(0, sans.rails[s].length).map(x => x.decal), sans.rails[s].map(x => x.decal), 'hypothèses d\'avant gardées, dans le même ordre');
+    /* Hors des zones du levier : rien. */
+    const abords = L1.hypothesesDuCut({ capture: cap, science: sci, seul, voisins: [], gMed: null, gen: { zone: 'abords', refMm: G } });
+    assert.deepEqual(abords.rails, sans.rails);
+  } finally { L1.reglerLeviers(null); }
+});
+test('genLargeMm : la voie déplacée d\'un bloc fait entrer le rail hors fenêtre ; plafond genMaxHyp tenu', () => {
+  try {
+    L1.reglerLeviers({ genLargeMm: [-130, 130], genMaxHyp: 3 });
+    const h = pool(), sans = L1.hypothesesDuCut({ capture: cap, science: sci, seul, voisins: [], gMed: null });
+    assert.ok(dmin(h, 'right') <= 10);
+    for (const s of SIDES) assert.ok(h.rails[s].filter(x => x.origines.includes('H7') && !x.hauteur).length <= 3);
+    assert.ok(SIDES.every(s => h.rails[s].length >= sans.rails[s].length));
+  } finally { L1.reglerLeviers(null); }
+});
+test('genTronques : les cellules fortes et compétitives écartées par MAX_HYP reviennent (H7, g-tronquee), sans relance du moteur', () => {
+  const sans = L1.hypothesesDuCut({ capture: cap, science: sci, seul, voisins: [], gMed: null });
+  try {
+    L1.reglerLeviers({ genTronques: true });
+    let appels = 0; const f = Sh.scientificProposeBothAvecReservoir; Sh.scientificProposeBothAvecReservoir = c => { appels++; return f(c); };
+    let h; try { h = pool(); } finally { Sh.scientificProposeBothAvecReservoir = f; }
+    assert.equal(appels, 0);
+    for (const s of SIDES) {
+      const t = h.rails[s].filter(x => x.sous === 'g-tronquee' && !x.hauteur);
+      assert.ok(t.length <= sans.tronques[s].length);
+      for (const x of t) assert.ok(sans.tronques[s].some(m => Math.hypot(m[1] - x.decal[1], m[2] - x.decal[2]) < 0.01), 'une cellule tronquée');
+    }
+  } finally { L1.reglerLeviers(null); }
+});
