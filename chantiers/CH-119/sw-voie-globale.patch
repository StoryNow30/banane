diff -ruN a/tests/ch119-voie-globale-sw.test.cjs b/tests/ch119-voie-globale-sw.test.cjs
--- a/tests/ch119-voie-globale-sw.test.cjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/ch119-voie-globale-sw.test.cjs	2026-11-13 08:40:23.970143604 +0000
@@ -0,0 +1,41 @@
+'use strict';
+/* CH-119 — LA VOIE GLOBALE dans le service worker réel (VM), profil L1-se. Montage commun : tests/helpers/lot-profil.cjs (cuts 111 à 113, le 112 sans
+ * point). Le levier est coupé à la livraison : aucune commande ne change (tests/pose-lot-inchanges-4959.test.cjs et les essais lot-profil-*). Ici on l'allume
+ * en VM (leviers actifs vus par background.js) et on force son verdict sur le 113, posé par la chaîne : la pose n'est pas envoyée, le cut passe à la GCV2
+ * comme un différé ; il ne devient pas appui. */
+const { test } = require('node:test'), assert = require('node:assert/strict');
+const { decisions, production, base, K, S, SCOPE, EsvTrou, attendre } = require('./helpers/lot-profil.cjs');
+
+async function lot({ allume, veto }) {
+  const adapter = new EsvTrou([]), b = production({ adapter });
+  b.ctx.BananeSettings = { ...b.ctx.BananeSettings, voiePrediteOmbre: { ...S.voiePrediteOmbre, actif: false }, deplacerVue: { ...S.deplacerVue, actif: false }, lot: { ...S.lot, gardeApresDiffere: false } };
+  const G = b.ctx.BananeGcv2L1, appels = [], gcv2 = [];
+  b.ctx.BananeGcv2L1 = { ...G,
+    leviersActifs: () => allume ? { ...G.leviersActifs(), voieGlobale: { zones: ['abords', 'adv'], W: 8, G: 4, T1: [0, 50, 60, 75, 100], T2: [0, 40, 60, 80, 100], cS: 0.1, rP: 1, theta: 0 } } : G.leviersActifs(),
+    voieGlobale: a => { appels.push({ cut: a.cut, zone: a.zone, voisins: a.voisins.map(v => v.identity.cut) }); return a.cut === 113 && veto ? { veto: true, ecart: 1, passe: 2, pose: 1, n: 1 } : { veto: false, ecart: -1, passe: 1, pose: 2, n: 1 }; },
+    deciderDiffere: a => { gcv2.push(a.capture.identity.cut); return G.deciderDiffere(a); } };
+  await b.api('connect', { tabId: 1 }); await b.api('settings', { mode: 'automatic-test' });
+  adapter.identity.cut = 111; adapter.rails = K.clone(base.rails); adapter.ajuster();
+  await b.api('start', { part: 23, start: 111, end: 113, ...SCOPE }); await b.settle(); await attendre(30);
+  return { b, appels, gcv2 };
+}
+
+test('voie globale coupée : jamais demandée, rien ne change', async () => {
+  const x = await lot({ allume: false, veto: true });
+  assert.equal(x.appels.length, 0);
+  const d113 = decisions(x.b).find(([c]) => c === 113)[1];
+  assert.notEqual(d113.command.action, 'defer', '113 posé par la chaîne');
+});
+
+test('voie globale allumée : pose de la chaîne hors de la voie → différé, GCV2, pas d\'appui ; sans refus, rien ne change', async () => {
+  const sans = await lot({ allume: true, veto: false });
+  const s113 = decisions(sans.b).find(([c]) => c === 113)[1];
+  assert.ok(sans.appels.some(a => a.cut === 113), 'la voie globale est demandée sur la pose de la chaîne');
+  assert.notEqual(s113.command.action, 'defer');
+  const x = await lot({ allume: true, veto: true });
+  const d113 = decisions(x.b).find(([c]) => c === 113)[1];
+  assert.equal(d113.voieGlobale.veto, true);
+  assert.ok(x.gcv2.includes(113), 'la GCV2 décide le 113');
+  assert.ok(d113.command.action === 'defer' || d113.command.l1s === 'gcv2', 'jamais la pose de la chaîne');
+  assert.notEqual(d113.anchorHeld, true, 'pas un appui');
+});
