diff --git a/tests/ch118-domaine-etendu.test.cjs b/tests/ch118-domaine-etendu.test.cjs
new file mode 100644
index 0000000..2488fb2
--- /dev/null
+++ b/tests/ch118-domaine-etendu.test.cjs
@@ -0,0 +1,58 @@
+'use strict';
+/* CH-118 (D-351) — domaine étendu du calage de convention sur le vertical.
+ * Réglage `conventionDomaineEtendu` de src/settings.js, COUPÉ par défaut (`null`). Coupé : `calibrate` rend, octet pour octet, la référence
+ * figée de la base 5.0 (même jeu synthétique que P1). Allumé `{dzMaxMm:13}` : un rail refusé pour |dz| seul (|du| ≤ 8, |dz| ≤ 13) reçoit le
+ * calage entier, motif `shift-out-of-domain` gardé (garde de paire D-044), `domaineEtendu: true` ; tout autre rail est rendu à l'identique. */
+const {test}=require('node:test'),assert=require('node:assert/strict');
+const fs=require('node:fs'),path=require('node:path');
+const Convention=require('../src/placement-convention.js'),Settings=require('../src/settings.js');
+const {capture,raw,CAS,lancer}=require('./helpers/p1-convention-cas.cjs');
+const reference=JSON.parse(fs.readFileSync(path.join(__dirname,'corpus','p1-convention-reference.json'),'utf8')).resultats;
+function avec(reglages,fn){
+  const avant=Object.getOwnPropertyDescriptor(globalThis,'BananeSettings');
+  globalThis.BananeSettings={...Settings,...reglages};
+  try{return fn();}finally{if(avant)Object.defineProperty(globalThis,'BananeSettings',avant);else delete globalThis.BananeSettings;}
+}
+const ACTIF={conventionDomaineEtendu:{dzMaxMm:13}};
+
+test('le réglage existe et il est coupé par défaut',()=>{
+  assert.ok('conventionDomaineEtendu' in Settings);
+  assert.equal(Settings.conventionDomaineEtendu,null);
+  assert.equal(typeof Convention.domaineEtendu,'function');
+});
+
+test('coupé, absent ou mal formé : octet pour octet la base 5.0',()=>{
+  for(const [nom,r] of [['défaut',{}],['null',{conventionDomaineEtendu:null}],['vrai',{conventionDomaineEtendu:true}],['sans borne',{conventionDomaineEtendu:{}}],
+    ['borne sous le domaine',{conventionDomaineEtendu:{dzMaxMm:3}}],['borne au-delà de 20',{conventionDomaineEtendu:{dzMaxMm:40}}]]){
+    const out=avec(r,()=>lancer(Convention));
+    for(let i=0;i<CAS.length;i++)assert.equal(out[i],reference[i],`${nom} : ${CAS[i].nom}`);
+  }
+});
+
+test('allumé : seuls les rails refusés pour dz seul, dz ≤ 13, changent ; ils reçoivent le calage entier',()=>{
+  const out=avec(ACTIF,()=>lancer(Convention));let etendus=0,inchanges=0;
+  for(let i=0;i<CAS.length;i++){
+    const ref=JSON.parse(reference[i]),r=JSON.parse(out[i]);
+    const cap=(CAS[i].options&&CAS[i].options.maxShiftMm)||8,vise=ref.reason==='shift-out-of-domain'&&Math.abs(ref.duMm)<=cap&&Math.abs(ref.dzMm)<=13;
+    if(!vise){assert.equal(out[i],reference[i],CAS[i].nom);inchanges++;continue;}
+    etendus++;
+    assert.equal(r.applied,true);assert.equal(r.reason,'shift-out-of-domain');assert.equal(r.domaineEtendu,true);assert.equal(r.dzMaxMm,13);
+    const mirror=!!(CAS[i].cap&&CAS[i].cap.mirror),b=raw(mirror),sign=mirror?-1:1;
+    assert.ok(Math.abs(r.delta[2]-(b[2]+ref.dzMm/1000))<1e-12,'dz entier');
+    assert.ok(Math.abs(r.delta[1]-(b[1]+sign*ref.duMm/1000))<1e-12,'du entier');
+  }
+  assert.ok(inchanges>20,'cas inchangés couverts');
+  if(!etendus)assert.fail('le jeu synthétique doit contenir au moins un rail refusé pour dz seul ≤ 13 mm');
+});
+
+test('allumé : |du| hors domaine reste refusé, |dz| au-delà de la borne reste refusé, le plafond P1 garde la priorité',()=>{
+  const c=CAS.find(x=>{const r=JSON.parse(reference[CAS.indexOf(x)]);return r.reason==='shift-out-of-domain'&&Math.abs(r.duMm)<=8&&Math.abs(r.dzMm)<=13;});
+  const cap=capture(c.cap||{}),side=c.side||'left',d=raw(!!(c.cap&&c.cap.mirror));
+  const ref=Convention.calibrate(cap,side,d,c.options||{});
+  const borne=Convention.calibrate(cap,side,d,{...(c.options||{}),domaineEtendu:{dzMaxMm:Math.max(8.01,Math.abs(ref.dzMm)-0.01)}});
+  assert.equal(borne.applied,false);assert.equal(borne.reason,'shift-out-of-domain');
+  const p1=avec({...ACTIF,conventionPlafond:true},()=>Convention.calibrate(cap,side,d,c.options||{}));
+  assert.equal(p1.capped,true);assert.equal(p1.domaineEtendu,undefined);
+  const du=CAS.map((x,i)=>[x,JSON.parse(reference[i])]).filter(([x,r])=>r.reason==='shift-out-of-domain'&&Math.abs(r.duMm)>((x.options&&x.options.maxShiftMm)||8));
+  for(const [x] of du){const r=avec(ACTIF,()=>Convention.calibrate(capture(x.cap||{}),x.side||'left',raw(!!(x.cap&&x.cap.mirror)),x.options||{}));assert.equal(r.applied,false,x.nom);}
+});
