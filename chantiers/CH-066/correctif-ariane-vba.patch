+/// Clé d'index de tableau au sens de JS (« 0 » à « 4294967294 », écriture décimale canonique) : un objet JS les range
+/// d'abord, dans l'ordre croissant, quel que soit l'ordre d'affectation.
+fn indice(c: &str) -> Option<u32> {
+    let n: u32 = c.parse().ok()?;
+    (n != u32::MAX && n.to_string() == c).then_some(n)
+}
+
+/// Canonise un objet comme le ferait le décodeur JS (CH-066, R4) : une clé en double garde sa PREMIÈRE place et sa
+/// DERNIÈRE valeur (affectations successives) ; les clés d'index viennent d'abord, en ordre croissant ; les autres
+/// gardent leur ordre.
+fn canoniser_objet(e: &[(String, Valeur)]) -> Valeur {
+    let mut t: Vec<(String, Valeur)> = Vec::with_capacity(e.len());
+    for (k, x) in e {
+        match t.iter_mut().find(|(c, _)| c == k) { Some(p) => p.1 = x.canonique(), None => t.push((k.clone(), x.canonique())) }
+    }
+    let (mut indices, autres): (Vec<_>, Vec<_>) = t.into_iter().partition(|(k, _)| indice(k).is_some());
+    indices.sort_by_key(|(k, _)| indice(k));
+    indices.extend(autres);
+    Valeur::Objet(indices)
+}
+
 /// Canonise un tableau `06` (voir [`Valeur::canonique`]).
